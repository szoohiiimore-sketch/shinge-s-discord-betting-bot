# Runtime
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Database
DATABASE_URL=
DIRECT_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_ALERT_CHANNEL_ID=your_discord_alert_channel_id
DISCORD_LOW_ODDS_CHANNEL_ID=your_discord_low_odds_channel_id
DISCORD_PINNACLE_LED_CHANNEL_ID=your_pinnacle_led_channel_id
DISCORD_PINNACLE_LED_LOW_CHANNEL_ID=your_pinnacle_led_low_channel_id
DISCORD_SHARP_FINAL_V2_CHANNEL_ID=your_sharp_final_v2_channel_id
DISCORD_SHARP_FINAL_LOW_V2_CHANNEL_ID=your_sharp_final_low_v2_channel_id
DISCORD_URGENT_ALERT_CHANNEL_ID=your_discord_urgent_alert_channel_id
DISCORD_OUTCOMES_CHANNEL_ID=your_discord_outcomes_channel_id
# Dedicated seasonality channel — season warnings + weekly health report route ONLY here.
# If unset, the seasonality monitor and weekly report are no-ops (the /season command still works).
SEASON_CHANNEL_ID=your_discord_season_channel_id

# The Odds API
THE_ODDS_API_KEY=your_odds_api_key

# PandaScore
PANDASCORE_API_KEY=your_pandascore_api_key

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# OddsPapi (esports odds)
ODDSPAPI_API_KEY=your_oddspapi_api_key

# Business Logic
BETTING_DEFAULT_BANKROLL=10000
BETTING_MAX_CONCURRENT_BETS=10
BETTING_ANALYSIS_BUDGET_DAILY=50
MAX_ALERT_ODDS=3.0

# Live performance baseline (optional): live metrics only count settlements at/after this instant.
# LIVE_BASELINE_DATE=2026-06-12T18:00:00Z
