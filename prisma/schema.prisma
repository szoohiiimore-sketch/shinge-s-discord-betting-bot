generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserStatus {
  CREATED
  ACTIVE
}

enum CurrencyCode {
  HUF
  EUR
}

enum BankrollStatus {
  ACTIVE
}

enum SportCategory {
  TRADITIONAL
  ESPORTS
}

enum SportStatus {
  ACTIVE
  DEPRECATED
}

enum ApiSource {
  THE_ODDS_API
  PANDASCORE
}

enum LeagueStatus {
  ACTIVE
}

enum TeamStatus {
  ACTIVE
}

enum TeamLeagueStatus {
  ACTIVE
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum MatchResult {
  HOME_WIN
  AWAY_WIN
  DRAW
}

enum OddsMarket {
  H2H
  SPREADS
  TOTALS
}

enum AnalysisStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AnalysisTrigger {
  SCHEDULED
  ON_DEMAND
  RE_ANALYSIS
}

enum ValueLevel {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum PredictionStatus {
  PENDING
  PLACED
  SETTLED
  VOIDED
}

enum PredictionResult {
  WON
  LOST
  PUSH
  VOID
}

enum BetResult {
  WIN
  LOSS
  PUSH
}

/// Which detection model produced a ValueOpportunity. Both run live in parallel
/// (dual-model A/B); attribution survives detection → alerting → settlement →
/// CLV → reporting. See docs/audits/DUAL_MODEL_ALERTING_IMPLEMENTATION.md.
enum DetectionModel {
  LEGACY
  PINNACLE_LED
  LOW_ODDS_LEGACY
  LOW_ODDS_PINNACLE_LED
  SHARP_FINAL
  SHARP_FINAL_LOW
  SHARP_FINAL_V2
  SHARP_FINAL_LOW_V2
  LEGACY_QUALITY
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

model User {
  id              String       @id @default(uuid()) @map("id") @db.Uuid
  discordId       String       @map("discord_id")
  discordUsername String       @map("discord_username")
  status          UserStatus   @default(CREATED) @map("status")
  firstSeenAt     DateTime     @default(now()) @map("first_seen_at")
  lastActiveAt    DateTime     @default(now()) @map("last_active_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  userPreferences UserPreferences? @relation("UserUserPreferences")
  bankroll        Bankroll?        @relation("UserBankroll")
  predictions     Prediction[]     @relation("UserPredictions")

  @@unique([discordId])
  @@index([status])
  @@map("users")
}

model UserPreferences {
  id                    String       @id @default(uuid()) @map("id") @db.Uuid
  userId                String       @map("user_id") @db.Uuid
  defaultStakePercent   Decimal      @default(1.00) @map("default_stake_percent")
  minConfidenceThreshold Decimal     @default(0.60) @map("min_confidence_threshold")
  minOddsThreshold      Decimal      @default(1.50) @map("min_odds_threshold")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user User @relation("UserUserPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("user_preferences")
}

model Bankroll {
  id              String         @id @default(uuid()) @map("id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  currency        CurrencyCode   @default(HUF) @map("currency")
  startingBalance Decimal        @map("starting_balance")
  currentBalance  Decimal        @map("current_balance")
  status          BankrollStatus @default(ACTIVE) @map("status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation("UserBankroll", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId])
  @@map("bankrolls")
}

model Sport {
  id                String       @id @default(uuid()) @map("id") @db.Uuid
  slug              String       @map("slug")
  name              String       @map("name")
  category          SportCategory @map("category")
  status            SportStatus  @default(ACTIVE) @map("status")
  externalApiSource ApiSource    @map("external_api_source")
  externalSportKey  String       @map("external_sport_key")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  leagues League[] @relation("SportLeagues")
  teams   Team[]   @relation("SportTeams")
  matches Match[]  @relation("SportMatches")

  @@unique([slug])
  @@map("sports")
}

model League {
  id         String       @id @default(uuid()) @map("id") @db.Uuid
  sportId    String       @map("sport_id") @db.Uuid
  externalId String       @map("external_id")
  name       String       @map("name")
  slug       String       @map("slug")
  status     LeagueStatus @default(ACTIVE) @map("status")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  sport       Sport        @relation("SportLeagues", fields: [sportId], references: [id], onDelete: Restrict)
  teamLeagues TeamLeague[] @relation("LeagueTeamLeagues")
  matches     Match[]      @relation("LeagueMatches")

  @@unique([sportId, externalId])
  @@index([sportId])
  @@map("leagues")
}

model Team {
  id         String     @id @default(uuid()) @map("id") @db.Uuid
  sportId    String     @map("sport_id") @db.Uuid
  externalId String     @map("external_id")
  name       String     @map("name")
  slug       String     @map("slug")
  status     TeamStatus @default(ACTIVE) @map("status")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  sport       Sport        @relation("SportTeams", fields: [sportId], references: [id], onDelete: Restrict)
  teamLeagues TeamLeague[] @relation("TeamTeamLeagues")
  homeMatches Match[]      @relation("TeamHomeMatches")
  awayMatches Match[]      @relation("TeamAwayMatches")

  @@unique([sportId, externalId])
  @@index([sportId])
  @@map("teams")
}

model TeamLeague {
  id        String           @id @default(uuid()) @map("id") @db.Uuid
  teamId    String           @map("team_id") @db.Uuid
  leagueId  String           @map("league_id") @db.Uuid
  status    TeamLeagueStatus @default(ACTIVE) @map("status")
  createdAt DateTime         @default(now()) @map("created_at")

  team   Team   @relation("TeamTeamLeagues", fields: [teamId], references: [id], onDelete: Cascade)
  league League @relation("LeagueTeamLeagues", fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([teamId, leagueId])
  @@index([teamId])
  @@index([leagueId])
  @@map("team_leagues")
}

model Match {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  externalId   String      @map("external_id")
  sportId      String      @map("sport_id") @db.Uuid
  leagueId     String      @map("league_id") @db.Uuid
  homeTeamId   String      @map("home_team_id") @db.Uuid
  awayTeamId   String      @map("away_team_id") @db.Uuid
  startTime    DateTime    @map("start_time")
  status       MatchStatus @default(SCHEDULED) @map("status")
  homeScore    Int?        @map("home_score")
  awayScore    Int?        @map("away_score")
  result       MatchResult? @map("result")
  lastFetchedAt DateTime?  @map("last_fetched_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  sport         Sport          @relation("SportMatches", fields: [sportId], references: [id], onDelete: Restrict)
  league        League         @relation("LeagueMatches", fields: [leagueId], references: [id], onDelete: Restrict)
  homeTeam      Team           @relation("TeamHomeMatches", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam      Team           @relation("TeamAwayMatches", fields: [awayTeamId], references: [id], onDelete: Restrict)
  oddsSnapshots      OddsSnapshot[]      @relation("MatchOddsSnapshots")
  analyses           Analysis[]          @relation("MatchAnalyses")
  predictions        Prediction[]        @relation("MatchPredictions")
  valueOpportunities ValueOpportunity[]  @relation("MatchValueOpportunities")

  @@unique([externalId])
  @@index([sportId])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([startTime, status])
  @@index([status])
  @@map("matches")
}

model OddsSnapshot {
  id         String     @id @default(uuid()) @map("id") @db.Uuid
  matchId    String     @map("match_id") @db.Uuid
  bookmaker  String     @map("bookmaker")
  market     OddsMarket @map("market")
  outcome    String     @map("outcome")
  price      Decimal    @map("price")
  isMain     Boolean    @default(false) @map("is_main")
  isLive     Boolean    @default(false) @map("is_live")
  capturedAt DateTime   @default(now()) @map("captured_at")

  match Match @relation("MatchOddsSnapshots", fields: [matchId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([matchId, capturedAt])
  @@map("odds_snapshots")
}

model Analysis {
  id                String          @id @default(uuid()) @map("id") @db.Uuid
  matchId           String          @map("match_id") @db.Uuid
  status            AnalysisStatus  @default(QUEUED) @map("status")
  trigger           AnalysisTrigger @map("trigger")
  predictedWinner   String?         @map("predicted_winner")
  confidence        Decimal?        @map("confidence")
  reasoning         String?         @map("reasoning")
  keyFactors        String[]        @map("key_factors")
  recommendedMarket OddsMarket?     @map("recommended_market")
  valueAssessment   ValueLevel?     @map("value_assessment")
  oddsUsed          Json?           @map("odds_used")
  tokensUsed        Int?            @map("tokens_used")
  costUsd           Decimal?        @map("cost_usd")
  errorMessage      String?         @map("error_message")
  completedAt       DateTime?       @map("completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  match       Match        @relation("MatchAnalyses", fields: [matchId], references: [id], onDelete: Restrict)
  predictions Prediction[] @relation("AnalysisPredictions")

  @@index([matchId])
  @@index([matchId, status])
  @@index([status])
  @@map("analyses")
}

model Prediction {
  id               String            @id @default(uuid()) @map("id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  matchId          String            @map("match_id") @db.Uuid
  analysisId       String            @map("analysis_id") @db.Uuid
  status           PredictionStatus  @default(PENDING) @map("status")
  market           OddsMarket        @map("market")
  predictedOutcome String            @map("predicted_outcome")
  oddsAtPlacement  Decimal           @map("odds_at_placement")
  bookmaker        String            @map("bookmaker")
  stake            Decimal           @map("stake")
  confidence       Decimal           @map("confidence")
  expectedValue    Decimal           @map("expected_value")
  valueAssessment  ValueLevel        @map("value_assessment")
  result           PredictionResult? @map("result")
  pnl              Decimal?          @map("pnl")
  roi              Decimal?          @map("roi")
  closingOdds      Decimal?          @map("closing_odds")
  wasCorrect       Boolean?          @map("was_correct")
  settledAt        DateTime?         @map("settled_at")
  voidReason       String?           @map("void_reason")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user     User     @relation("UserPredictions", fields: [userId], references: [id], onDelete: Restrict)
  match    Match    @relation("MatchPredictions", fields: [matchId], references: [id], onDelete: Restrict)
  analysis Analysis @relation("AnalysisPredictions", fields: [analysisId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([matchId])
  @@index([analysisId])
  @@index([userId, status])
  @@index([matchId, status])
  @@index([status])
  @@index([createdAt])
  @@map("predictions")
}

model ValueOpportunity {
  id                   String   @id @default(uuid()) @map("id") @db.Uuid
  matchId              String   @map("match_id") @db.Uuid
  sport                String   @map("sport")
  bookmaker            String   @map("bookmaker")
  outcome              String   @map("outcome")
  bookmakerOdds        Decimal  @map("bookmaker_odds")
  fairOdds             Decimal  @map("fair_odds")
  edgePercentage       Decimal  @map("edge_percentage")
  consensusProbability Decimal  @map("consensus_probability")
  consensusBookmakers  String[] @map("consensus_bookmakers")
  capturedAt           DateTime  @map("captured_at")
  alertedAt            DateTime? @map("alerted_at")
  settledAt            DateTime? @map("settled_at")
  betResult            BetResult? @map("bet_result")
  profitLossUnits      Decimal?  @map("profit_loss_units")
  /// Raw Pinnacle price for this outcome in the last pre-kickoff snapshot batch.
  closingPinnacleOdds  Decimal?  @map("closing_pinnacle_odds")
  /// CLV% = (alert odds / de-vigged Pinnacle closing fair odds − 1) × 100. Set at settlement.
  clvPercentage        Decimal?  @map("clv_percentage")
  clvPositive          Boolean?  @map("clv_positive")
  /// When true, edge was in the shadow tier (>= 2% and < 3%). Shadow rows are stored for
  /// CLV and threshold-calibration analysis but never send Discord alerts and are excluded
  /// from all production ROI metrics. False (default) = production opportunity (edge >= 3%).
  isShadow             Boolean   @default(false) @map("is_shadow")
  /// Pinnacle price movement % for the alerted outcome over the trailing window at capture:
  /// (latest price / oldest price in window − 1) × 100. Negative = price shortened (market
  /// moved TOWARD the outcome). Null when no earlier Pinnacle snapshot exists in the window.
  /// Analytics only — never used by detection, alerting, or settlement.
  pinnacleMove1h       Decimal?  @map("pinnacle_move_1h")
  pinnacleMove6h       Decimal?  @map("pinnacle_move_6h")
  pinnacleMove24h      Decimal?  @map("pinnacle_move_24h")
  /// Producing model. Backfilled: legacy-era rows (candidate = pinnacle) are LEGACY.
  model                DetectionModel @default(PINNACLE_LED) @map("model")
  /// Legacy-family confidence grade (A/B/C) — ranking/reporting only, never suppression.
  confidence           String?   @map("confidence")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  match Match @relation("MatchValueOpportunities", fields: [matchId], references: [id], onDelete: Restrict)

  @@unique([matchId, bookmaker, outcome, capturedAt])
  @@index([matchId])
  @@index([edgePercentage])
  @@index([capturedAt])
  @@index([alertedAt])
  @@index([settledAt])
  @@index([betResult])
  @@index([isShadow])
  @@index([model])
  @@index([createdAt])
  @@map("value_opportunities")
}

// ──────────────────────────────────────────────
// HISTORICAL BACKTESTING ENGINE — segregated research storage.
// These tables are written and read ONLY by the offline engine
// (src/backtest + scripts/backtest). They share no rows, foreign keys,
// or indexes with the live OddsSnapshot / ValueOpportunity pipeline.
// See docs/audits/HISTORICAL_BACKTESTING_ENGINE_DESIGN.md §3.
// ──────────────────────────────────────────────

/// An event from The Odds API historical feed. Deliberately NOT joined to the
/// live Match/Team tables — historical identity stays in the API's own id space
/// so backfills can never pollute live reference data.
model HistoricalEvent {
  id           String   @id @map("id") // The Odds API event id
  sportKey     String   @map("sport_key")
  commenceTime DateTime @map("commence_time")
  homeTeam     String   @map("home_team")
  awayTeam     String   @map("away_team")
  /// Winning H2H outcome name, inferred from stored in-play prices (median price
  /// collapsed to <= WIN threshold late in the match). Null = unresolved.
  resultOutcome    String?   @map("result_outcome")
  /// How the result was determined (e.g. INPLAY_PRICE). Null = unresolved.
  resultMethod     String?   @map("result_method")
  /// snapshot_at of the in-play batch the inference is based on.
  resultEvidenceAt DateTime? @map("result_evidence_at")
  createdAt    DateTime @default(now()) @map("created_at")

  snapshots HistoricalOddsSnapshot[] @relation("HistoricalEventSnapshots")

  @@index([sportKey, commenceTime])
  @@map("historical_events")
}

/// Append-only historical odds rows backfilled from /v4/historical. One row per
/// (event, bookmaker, market, outcome, snapshot_at). Never read by live code.
model HistoricalOddsSnapshot {
  id         BigInt   @id @default(autoincrement()) @map("id")
  eventId    String   @map("event_id")
  sportKey   String   @map("sport_key")
  bookmaker  String   @map("bookmaker")
  market     String   @default("h2h") @map("market")
  outcome    String   @map("outcome")
  price      Decimal  @map("price")
  snapshotAt DateTime @map("snapshot_at")
  createdAt  DateTime @default(now()) @map("created_at")

  event HistoricalEvent @relation("HistoricalEventSnapshots", fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, bookmaker, market, outcome, snapshotAt])
  @@index([sportKey, snapshotAt])
  @@index([eventId, snapshotAt])
  @@map("historical_odds_snapshots")
}

/// Resumable backfill progress per (sport, plan). Idempotent re-runs: inserts
/// use skipDuplicates against the snapshot unique key; the cursor only avoids
/// re-spending credits on already-fetched timestamps.
model HistoricalIngestionCursor {
  id             String    @id @map("id") // `${sportKey}|${planKey}`
  sportKey       String    @map("sport_key")
  planKey        String    @map("plan_key")
  lastTimestamp  DateTime? @map("last_timestamp")
  requestsUsed   Int       @default(0) @map("requests_used")
  creditsUsed    Int       @default(0) @map("credits_used")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("historical_ingestion_cursors")
}

/// One backtest run = (config JSONB, period, cadence mode, code version).
/// Runs are cheap to create and drop; deleting a run cascades its opportunities.
model BacktestRun {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  name        String   @map("name")
  /// Full BacktestRunConfig as JSON — frozen before replay starts.
  config      Json     @map("config")
  /// git SHA of the code that produced the run (replay-parity guard).
  codeVersion String   @map("code_version")
  /// 'live-cadence' (predicts production) | 'full-resolution' (measures ceiling).
  cadenceMode String   @map("cadence_mode")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  /// CREATED → REPLAYED → SCORED
  status      String   @default("CREATED") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")

  opportunities BacktestOpportunity[] @relation("BacktestRunOpportunities")

  @@map("backtest_runs")
}

/// Backtest detections + ML feature store. Feature columns are written by the
/// replay engine at detection time (same pure functions as live — no
/// training/serving skew); label columns (clv_*, bet_result, pl_units) are
/// written ONLY by the scoring layer after replay completes.
model BacktestOpportunity {
  id                   BigInt   @id @default(autoincrement()) @map("id")
  runId                String   @map("run_id") @db.Uuid
  eventId              String   @map("event_id")
  sportKey             String   @map("sport_key")
  bookmaker            String   @map("bookmaker")
  outcome              String   @map("outcome")
  bookmakerOdds        Decimal  @map("bookmaker_odds")
  fairOdds             Decimal  @map("fair_odds")
  edgePercentage       Decimal  @map("edge_percentage")
  consensusProbability Decimal  @map("consensus_probability")
  isShadow             Boolean  @map("is_shadow")
  /// The replay cursor timestamp at which the candidate was detected.
  detectedAt           DateTime @map("detected_at")
  commenceTime         DateTime @map("commence_time")

  // ── Feature columns (replay-written) ──
  referenceOverround   Decimal  @map("reference_overround")
  bookmakerFamily      String   @map("bookmaker_family")
  minutesToKickoff     Int      @map("minutes_to_kickoff")
  pinnacleMove1h       Decimal? @map("pinnacle_move_1h")
  pinnacleMove6h       Decimal? @map("pinnacle_move_6h")
  pinnacleMove24h      Decimal? @map("pinnacle_move_24h")
  /// % gap between this candidate's odds and the second-best non-exchange odds
  /// for the same outcome in the batch. Large gap = lone-outlier (ghost-price) signal.
  priceGapPct          Decimal? @map("price_gap_pct")
  /// Distinct non-exchange bookmaker families >= shadow threshold for the same
  /// outcome in the same batch (corroboration k at detection time).
  corroborationK       Int      @map("corroboration_k")

  // ── Label columns (scorer-written only) ──
  closingPinnacleOdds  Decimal? @map("closing_pinnacle_odds")
  closingFairOdds      Decimal? @map("closing_fair_odds")
  clvPercentage        Decimal? @map("clv_percentage")
  clvPositive          Boolean? @map("clv_positive")
  betResult            String?  @map("bet_result")
  profitLossUnits      Decimal? @map("profit_loss_units")

  createdAt            DateTime @default(now()) @map("created_at")

  run BacktestRun @relation("BacktestRunOpportunities", fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, eventId])
  @@index([runId, isShadow])
  @@map("backtest_opportunities")
}
